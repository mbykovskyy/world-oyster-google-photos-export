{
  "manifest_version": 3,
  "name": "World Oyster Photo Picker",
  "version": "0.2.0",
  "description": "Select Google Photos for the World Oyster slideshow. Selection is kept in extension storage so you can navigate away and resume.",
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://photos.google.com/*", "https://nominatim.openstreetmap.org/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["page-rpc.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://photos.google.com/*"],
      "js": ["zip.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "World Oyster Photo Picker",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
